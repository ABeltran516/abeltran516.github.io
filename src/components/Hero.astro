---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import ThreeBodies from '../assets/shapes/3bodies-shape.svg';
import BinarySystem from '../assets/shapes/binary-system.svg';
import BlueComet from '../assets/shapes/blue-comet-shape.svg';
import BlueLine from '../assets/shapes/blueline-shape.svg';
import BrownAircraft from '../assets/shapes/brown-aircraft-shape.svg';
import LilStar from '../assets/shapes/lilstar-shape.svg';
import RedTriangle from '../assets/shapes/red-triangle-shape.svg';
import Star from '../assets/shapes/star-shape.svg';
import StarTriangle from '../assets/shapes/star-triangle-shape.svg';
import Sun from '../assets/shapes/sun-shape.svg';
import { socialLinks } from '../data/social';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Decorative shapes. `size` is the desktop width in rem; smaller screens scale it
// down with --shape-scale. `wide` shapes only appear from 512px up.
const shapes = [
  { Shape: ThreeBodies, size: 10, top: '60%', left: '15%', wide: true },
  { Shape: BinarySystem, size: 5, top: '20%', right: '20%' },
  { Shape: BlueComet, size: 3.75, top: '10%', left: '30%' },
  { Shape: BlueLine, size: 5, bottom: '15%', right: '30%' },
  { Shape: BrownAircraft, size: 3.75, top: '30%', left: '10%' },
  { Shape: LilStar, size: 2.5, top: '8%', right: '35%', wide: true },
  { Shape: RedTriangle, size: 5, bottom: '15%', left: '45%' },
  { Shape: Star, size: 5, top: '4%', left: '12%', wide: true },
  { Shape: StarTriangle, size: 10, bottom: '35%', right: '5%', wide: true },
  { Shape: Sun, size: 3.75, bottom: '10%', left: '15%', wide: true },
];
---

<section class="hero">
  <div class="hero__shapes" aria-hidden="true">
    {
      shapes.map(({ Shape, size, wide, ...position }) => (
        <Shape
          class:list={['hero__shape', { 'hero__shape--wide': wide }]}
          style={{ '--shape-size': `${size}rem`, ...position }}
        />
      ))
    }
  </div>

  <Image
    class="hero__avatar"
    src={avatar}
    alt="Antonio Beltrán"
    width={320}
    loading="eager"
    fetchpriority="high"
  />

  <h1 class="hero__name">Antonio Beltrán</h1>
  <p class="hero__role">{t('hero.role')}</p>

  <ul class="hero__social">
    {
      socialLinks.map(({ name, href, icon, external }) => (
        <li>
          <a
            class="hero__social-link"
            href={href}
            aria-label={name}
            {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
          >
            <Image src={icon} alt="" width={28} height={28} />
          </a>
        </li>
      ))
    }
  </ul>

  <a class="hero__cta" href="#contact">{t('hero.contact')}</a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-small);
    min-height: 90svh;
    padding: var(--spacing-bigger) var(--spacing-medium);
    text-align: center;
    container-type: inline-size;
  }

  .hero__shapes {
    --shape-scale: 0.75;

    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__shape {
    position: absolute;
    width: calc(var(--shape-size) * var(--shape-scale));
    height: auto;
  }

  .hero__shape--wide {
    display: none;
  }

  .hero__avatar {
    width: 9.5rem;
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid var(--border-color);
    border-radius: 50%;
  }

  .hero__name {
    margin-top: var(--spacing-small);
    font-size: var(--font-size-extralarge);
    color: var(--title-color);
  }

  .hero__role {
    font-size: var(--font-size-big);
  }

  .hero__social {
    display: flex;
    gap: var(--spacing-small);
    list-style: none;
  }

  .hero__social-link {
    display: inline-flex;
    padding: 0.5rem;
    transition: transform 0.3s;
  }

  .hero__social-link:hover {
    transform: scale(1.3);
  }

  .hero__cta {
    margin-top: var(--spacing-bigger);
    padding: var(--spacing-small) var(--spacing-big);
    font-size: var(--font-size-big);
    font-weight: 700;
    color: var(--body-color);
    text-decoration: none;
    background-color: var(--main-color);
    border: 2px solid var(--border-color);
    border-radius: 999px;
    transition: transform 0.3s;
  }

  .hero__cta:hover {
    transform: scale(1.1);
  }

  /* Container queries: children of .hero adapt to the hero's width, not the viewport's.
     (A container can't restyle itself, only its descendants.) */
  @container (min-width: 512px) {
    .hero__shape--wide {
      display: block;
    }
  }

  @container (min-width: 769px) {
    .hero__shapes {
      --shape-scale: 1;
    }
  }
</style>
